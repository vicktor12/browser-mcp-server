# Diretório de dados do Chrome (mantém sessões/logins). Se vazio, usa perfil dedicado temporário.
# Mac:     /Users/SEU_USUARIO/Library/Application Support/Google/Chrome
# Windows: C:\Users\SEU_USUARIO\AppData\Local\Google\Chrome\User Data
# Linux:   /home/SEU_USUARIO/.config/google-chrome
CHROME_USER_DATA_DIR=

# Perfil do Chrome a usar (Default é o perfil padrão)
CHROME_PROFILE=Default

# Diretório onde screenshots serão salvas (default: <tmpdir>/browser-mcp-screenshots)
SCREENSHOTS_DIR=

# Arquivo de auditoria (default: <tmpdir>/browser-mcp-audit.log)
AUDIT_LOG=

# "true" roda sem janela, "false" abre o Chrome visível
BROWSER_HEADLESS=false

# Timeout padrão para operações no browser (ms)
BROWSER_TIMEOUT=15000

# Domínios bloqueados (substring do hostname), separados por vírgula
BLOCKED_DOMAINS=banco,pagamento,financeiro,pix,transferencia
